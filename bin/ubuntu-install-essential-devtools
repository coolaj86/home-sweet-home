#!/bin/sh
#shellcheck disable=SC1090
set -e
set -u

apt-get update
apt-get dist-upgrade
apt-get install -y curl fish git htop less screen vim wget xz-utils unzip zstd

echo LANG=en_US.UTF-8 | tee /etc/default/locale

wget -O - https://webi.sh/ssh-utils | sh
. ~/.config/envman/PATH.env

ssh-adduser 'app'

curl https://webi.sh/ssh-pubkey | sh
ssh-pubkey
echo 'screen -xRS awesome -s fish' >> ~/.profile
webi ssh-authorize

webi aliasman rg vim-essentials vim-commentary vim-go go-essentials
